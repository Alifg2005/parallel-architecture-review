# ---------------------------------------------------------------
# PRIVATE LECTURE MATERIAL — never commit, never deploy.
# Original slides (PDF / PPTX / etc.) live only in /private-material.
# ---------------------------------------------------------------
/private-material/*
!/private-material/.gitkeep
!/private-material/README.md

# Belt and braces: no slide decks or PDFs anywhere in the repo.
# There is no authorised exception; do not add one without the owner's approval.
*.pdf
*.PDF
*.ppt
*.pptx
*.PPTX
*.key
*.odp

# Dependencies and build output
node_modules/
dist/
dist-ssr/
coverage/
*.local
.vercel

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment files (no secrets are needed, but never commit any)
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.sw?
